# Copy this file to .env and fill it in. Never commit .env.
# Turn on Discord Developer Mode (User Settings > Advanced) to right-click > Copy ID.

# --- Discord: from YOUR OWN test bot (Developer Portal > your app > Bot > Reset Token) ---
DISCORD_TOKEN=
# Your practice server's ID
GUILD_ID=
# Channel IDs in your practice server
SPOTTED_CHANNEL_ID=
BIRTHDAY_CHANNEL_ID=

# --- Where the bot finds the API ---
API_BASE_URL=http://127.0.0.1:8000

# --- Where the API keeps its data (created automatically) ---
DATABASE_PATH=spots.db
